# ── Frontend build vars (baked into the JS bundle at build time) ──────────────
# Set VITE_API_URL to https://api.your-domain.example (or http://YOUR_SERVER_IP:8000)
VITE_API_URL=https://api.your-domain.example
VITE_MAPBOX_TOKEN=pk.your-mapbox-public-token
VITE_GOOGLE_PLACES_API_KEY=AIzaSy...

# ── Supabase ──────────────────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=<paste_supabase_anon_jwt_here>

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=generate_with_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Email / OTP ───────────────────────────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_gmail@gmail.com
SENDER_PASSWORD=your_16char_app_password
OTP_EXPIRY_MINUTES=10
MAX_OTP_ATTEMPTS=5

# ── Google APIs ───────────────────────────────────────────────────────────────
GOOGLE_PLACES_API_KEY=AIzaSy...
GOOGLE_API_KEY=AIzaSy...

# ── Flight search ─────────────────────────────────────────────────────────────
# Amadeus (flight search)
AMADEUS_API_KEY=your_amadeus_api_key
AMADEUS_API_SECRET=your_amadeus_api_secret
# fast-flights — no API key needed

# ── Stripe (billing) ─────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...

# ── Web Push / VAPID ─────────────────────────────────────────────────────────
# Generate with: cd backend && python generate_vapid_keys.py
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=mailto:your_email@example.com

# ── Public URLs (used to build invite links, story links, watermarks) ────────
# Operator must set these in production.
FRONTEND_URL=https://your-domain.example
INVITE_BASE_URL=https://your-domain.example/join

# ── CORS — comma-separated, no spaces ────────────────────────────────────────
CORS_ORIGINS=https://your-domain.example,http://localhost:5173

# ── API docs ─────────────────────────────────────────────────────────────────
# Set to "true" to expose /docs, /redoc, /openapi.json. Off by default in
# production so the route surface and request schemas aren't public.
ENABLE_API_DOCS=false
