# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?


# Environment variables — never commit real secrets
venv
venv/
.venv/
.env
.env.*
*.env
*.env.*
env/
.env/

# frontend/.env.production is intentionally committed — it contains only
# public VITE_ build-time tokens (Supabase anon key, Mapbox public token, etc.)
# that are baked into the JS bundle anyway. No server-side secrets here.
!frontend/.env.production

# frontend/.env.local has real local overrides — keep ignored
frontend/.env.local

# Python cache / bytecode
__pycache__/
*.py[cod]
*$py.class


.CLAUDE.md
CLAUDE.md

# Large media files
*.mp4
*.mov
*.avi
*.mkv
